(version 20.1)

(build
 (progn
  (when
   %{pkg-self:dev}
   (run dune subst))
  (run dune build -p %{pkg-self:name} -j %{jobs})))

(depends ocaml dune conf-autoconf seq ocamlfind)

(source
 (fetch
  (url https://github.com/ocamllibs/stdcompat/archive/refs/tags/20.1.tar.gz)
  (checksum
   sha512=c482cae49459704100812cb6caa8e8ffa60ffc2414a0ac4c3ec41bdd4203d8299c69be3ab2f7f8764b58b9173e43b89faf70036a19dc5674aa87108ff07c4c60)))
