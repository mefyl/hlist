(alias
 (name default)
 (deps))

(rule
 (target hlist.%{version:hlist}.opam)
 (deps
  (:opam ../hlist.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (run
     git
     log
     "--pretty=url { src: \"git://git@gitlab.routine.co:routine/hlist#%H\" }"
     -n1)))))

(rule
 (target hlist-ios.opam)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:../.logistic/ci/dune/dune_sak.exe}
    rewrite-ios
    --input
    %{dep:../hlist.opam}
    --cross
    hlist
    --cross-both
    ""
    --cross-exclude
    ""))))

(rule
 (target hlist-ios.%{version:hlist}.opam)
