opam-version: "2.0"
name: "hlist"
version: "0.2.0"
synopsis: "Heterogeneous lists"
maintainer: "mefyl <mefyl@gruntech.org>"
authors: "mefyl <mefyl@gruntech.org>"
license: "LGPL-3.0-or-later"
homepage: "https://github.com/mefyl/hlist"
bug-reports: "https://github.com/routine/hlist/-/issues"
depends: [
  "ocamlformat" {= "0.26.2"}
  "opam-file-format"
  "sexplib"
  "opam-dune-lint"
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "dune" {= "3.18.1"}
  "ocaml" {= "5.2.1"}
  "ocaml-base-compiler" {= "5.2.1"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
]
dev-repo: "git+https://github.com/mefyl/hlist.git"
